{
    "name": "smtping/smtping-php",
    "description": "Official SMTPing SDK for PHP: verify email addresses, run bulk list jobs, and check spamtrap, disposable, spambot and complainer lists.",
    "type": "library",
    "license": "MIT",
    "keywords": ["smtping", "email verification", "email validation", "email verifier", "bulk email verification", "disposable email", "spamtrap"],
    "homepage": "https://smtping.com/docs",
    "authors": [
        { "name": "SMTPing", "email": "support@smtping.com", "homepage": "https://smtping.com" }
    ],
    "support": {
        "email": "support@smtping.com",
        "docs": "https://smtping.com/docs",
        "issues": "https://github.com/smtping/smtping-php/issues",
        "source": "https://github.com/smtping/smtping-php"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": { "Smtping\\": "src/" }
    },
    "minimum-stability": "stable"
}
